<mujoco model="monitor">
  <!-- Note: compiler and option settings are inherited from robot XML during merge -->

  <asset>
    <mesh name="monitor_mesh" file="objects/monitor/monitor.obj" scale="1.0 1.0 1.0"/>
    <material name="monitor_mat" rgba="0.7 0.8 0.9 1"/>
  </asset>

  <default>
    <default class="monitor_phys">
      <geom
        contype="1" conaffinity="1"
        friction="0.6 0.01 0.01"
        solimp="0.99 0.99 0.01"
        solref="0.01 1"
        density="25"
      />
    </default>
  </default>

  <worldbody>
    <body name="monitor" pos="0 0 0.9" quat="1 0 0 0">
      <freejoint name="monitor_free"/>

      <geom class="monitor_phys"
            name="monitor_geom"
            type="mesh" mesh="monitor_mesh"
            material="monitor_mat"/>

      <!-- MuJoCo will compute mass, COM, and inertia from mesh geometry and density=25 -->
      <!-- Expected values: mass=0.036 kg, com=-0.002998 -0.023909 -0.003854, inertia=0.000032 0.000076 0.000105 -->
    </body>
  </worldbody>
</mujoco>
