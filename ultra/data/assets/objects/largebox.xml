<mujoco model="largebox">
  <!-- Note: compiler and option settings are inherited from robot XML during merge -->

  <asset>
    <mesh name="largebox_mesh" file="objects/largebox/largebox.obj" scale="1.0 1.0 1.0"/>
    <material name="largebox_mat" rgba="0.7 0.8 0.9 1"/>
  </asset>

  <default>
    <default class="largebox_phys">
      <geom
        contype="1" conaffinity="1"
        friction="0.6 0.01 0.01"
        solimp="0.99 0.99 0.01"
        solref="0.01 1"
        density="25"
      />
    </default>
  </default>

  <worldbody>
    <body name="largebox" pos="0 0 0.9" quat="1 0 0 0">
      <freejoint name="largebox_free"/>

      <geom class="largebox_phys"
            name="largebox_geom"
            type="mesh" mesh="largebox_mesh"
            material="largebox_mat"/>

      <!-- MuJoCo will compute mass, COM, and inertia from mesh geometry and density=25 -->
      <!-- Expected values: mass=0.330 kg, com=-0.000215 -0.000302 -0.001352, inertia=0.000576 0.000579 0.000557 -->
    </body>
  </worldbody>
</mujoco>
