<mujoco model="woodchair">
  <!-- Note: compiler and option settings are inherited from robot XML during merge -->

  <asset>
    <mesh name="woodchair_mesh" file="objects/woodchair/woodchair.obj" scale="1.0 1.0 1.0"/>
    <material name="woodchair_mat" rgba="0.7 0.8 0.9 1"/>
  </asset>

  <default>
    <default class="woodchair_phys">
      <geom
        contype="1" conaffinity="1"
        friction="0.6 0.01 0.01"
        solimp="0.99 0.99 0.01"
        solref="0.01 1"
        density="25"
      />
    </default>
  </default>

  <worldbody>
    <body name="woodchair" pos="0 0 0.9" quat="1 0 0 0">
      <freejoint name="woodchair_free"/>

      <geom class="woodchair_phys"
            name="woodchair_geom"
            type="mesh" mesh="woodchair_mesh"
            material="woodchair_mat"/>

      <!-- MuJoCo will compute mass, COM, and inertia from mesh geometry and density=25 -->
      <!-- Expected values: mass=0.047 kg, com=0.000493 0.000873 -0.004320, inertia=0.000293 0.000296 0.000247 -->
    </body>
  </worldbody>
</mujoco>
