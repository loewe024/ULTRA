<mujoco model="whitechair">
  <!-- Note: compiler and option settings are inherited from robot XML during merge -->

  <asset>
    <mesh name="whitechair_mesh" file="objects/whitechair/whitechair.obj" scale="1.0 1.0 1.0"/>
    <material name="whitechair_mat" rgba="0.7 0.8 0.9 1"/>
  </asset>

  <default>
    <default class="whitechair_phys">
      <geom
        contype="1" conaffinity="1"
        friction="0.6 0.01 0.01"
        solimp="0.99 0.99 0.01"
        solref="0.01 1"
        density="25"
      />
    </default>
  </default>

  <worldbody>
    <body name="whitechair" pos="0 0 0.9" quat="1 0 0 0">
      <freejoint name="whitechair_free"/>

      <geom class="whitechair_phys"
            name="whitechair_geom"
            type="mesh" mesh="whitechair_mesh"
            material="whitechair_mat"/>

      <!-- MuJoCo will compute mass, COM, and inertia from mesh geometry and density=25 -->
      <!-- Expected values: mass=0.046 kg, com=-0.005209 -0.026945 0.034423, inertia=0.000107 0.000144 0.000191 -->
    </body>
  </worldbody>
</mujoco>
