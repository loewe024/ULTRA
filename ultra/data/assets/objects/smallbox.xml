<mujoco model="smallbox">
  <!-- Note: compiler and option settings are inherited from robot XML during merge -->

  <asset>
    <mesh name="smallbox_mesh" file="objects/smallbox/smallbox.obj" scale="1.0 1.0 1.0"/>
    <material name="smallbox_mat" rgba="0.7 0.8 0.9 1"/>
  </asset>

  <default>
    <default class="smallbox_phys">
      <geom
        contype="1" conaffinity="1"
        friction="0.6 0.01 0.01"
        solimp="0.99 0.99 0.01"
        solref="0.01 1"
        density="25"
      />
    </default>
  </default>

  <worldbody>
    <body name="smallbox" pos="0 0 0.9" quat="1 0 0 0">
      <freejoint name="smallbox_free"/>

      <geom class="smallbox_phys"
            name="smallbox_geom"
            type="mesh" mesh="smallbox_mesh"
            material="smallbox_mat"/>

      <!-- MuJoCo will compute mass, COM, and inertia from mesh geometry and density=25 -->
      <!-- Expected values: mass=0.108 kg, com=0.003249 -0.005155 -0.006919, inertia=0.000109 0.000087 0.000151 -->
    </body>
  </worldbody>
</mujoco>
