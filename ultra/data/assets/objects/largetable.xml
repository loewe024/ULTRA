<mujoco model="largetable">
  <!-- Note: compiler and option settings are inherited from robot XML during merge -->

  <asset>
    <mesh name="largetable_mesh" file="objects/largetable/largetable.obj" scale="1.0 1.0 1.0"/>
    <material name="largetable_mat" rgba="0.7 0.8 0.9 1"/>
  </asset>

  <default>
    <default class="largetable_phys">
      <geom
        contype="1" conaffinity="1"
        friction="0.6 0.01 0.01"
        solimp="0.99 0.99 0.01"
        solref="0.01 1"
        density="25"
      />
    </default>
  </default>

  <worldbody>
    <body name="largetable" pos="0 0 0.9" quat="1 0 0 0">
      <freejoint name="largetable_free"/>

      <geom class="largetable_phys"
            name="largetable_geom"
            type="mesh" mesh="largetable_mesh"
            material="largetable_mat"/>

      <!-- MuJoCo will compute mass, COM, and inertia from mesh geometry and density=25 -->
      <!-- Expected values: mass=0.202 kg, com=0.000326 0.023987 0.000026, inertia=0.000938 0.001388 0.000937 -->
    </body>
  </worldbody>
</mujoco>
