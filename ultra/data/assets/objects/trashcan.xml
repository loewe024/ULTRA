<mujoco model="trashcan">
  <!-- Note: compiler and option settings are inherited from robot XML during merge -->

  <asset>
    <mesh name="trashcan_mesh" file="objects/trashcan/trashcan.obj" scale="1.0 1.0 1.0"/>
    <material name="trashcan_mat" rgba="0.7 0.8 0.9 1"/>
  </asset>

  <default>
    <default class="trashcan_phys">
      <geom
        contype="1" conaffinity="1"
        friction="0.6 0.01 0.01"
        solimp="0.99 0.99 0.01"
        solref="0.01 1"
        density="25"
      />
    </default>
  </default>

  <worldbody>
    <body name="trashcan" pos="0 0 0.9" quat="1 0 0 0">
      <freejoint name="trashcan_free"/>

      <geom class="trashcan_phys"
            name="trashcan_geom"
            type="mesh" mesh="trashcan_mesh"
            material="trashcan_mat"/>

      <!-- MuJoCo will compute mass, COM, and inertia from mesh geometry and density=25 -->
      <!-- Expected values: mass=0.147 kg, com=0.000186 0.036490 -0.000152, inertia=0.000087 0.000120 0.000093 -->
    </body>
  </worldbody>
</mujoco>
