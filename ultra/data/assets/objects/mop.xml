<mujoco model="mop">
  <!-- Note: compiler and option settings are inherited from robot XML during merge -->

  <asset>
    <mesh name="mop_mesh" file="objects/mop/mop.obj" scale="1.0 1.0 1.0"/>
    <material name="mop_mat" rgba="0.7 0.8 0.9 1"/>
  </asset>

  <default>
    <default class="mop_phys">
      <geom
        contype="1" conaffinity="1"
        friction="0.6 0.01 0.01"
        solimp="0.99 0.99 0.01"
        solref="0.01 1"
        density="25"
      />
    </default>
  </default>

  <worldbody>
    <body name="mop" pos="0 0 0.9" quat="1 0 0 0">
      <freejoint name="mop_free"/>

      <geom class="mop_phys"
            name="mop_geom"
            type="mesh" mesh="mop_mesh"
            material="mop_mat"/>

      <!-- MuJoCo will compute mass, COM, and inertia from mesh geometry and density=25 -->
      <!-- Expected values: mass=0.031 kg, com=-0.055647 0.064355 0.044215, inertia=0.000204 0.000175 0.000268 -->
    </body>
  </worldbody>
</mujoco>
