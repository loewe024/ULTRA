<mujoco model="floorlamp">
  <!-- Note: compiler and option settings are inherited from robot XML during merge -->

  <asset>
    <mesh name="floorlamp_mesh" file="objects/floorlamp/floorlamp.obj" scale="1.0 1.0 1.0"/>
    <material name="floorlamp_mat" rgba="0.7 0.8 0.9 1"/>
  </asset>

  <default>
    <default class="floorlamp_phys">
      <geom
        contype="1" conaffinity="1"
        friction="0.6 0.01 0.01"
        solimp="0.99 0.99 0.01"
        solref="0.01 1"
        density="25"
      />
    </default>
  </default>

  <worldbody>
    <body name="floorlamp" pos="0 0 0.9" quat="1 0 0 0">
      <freejoint name="floorlamp_free"/>

      <geom class="floorlamp_phys"
            name="floorlamp_geom"
            type="mesh" mesh="floorlamp_mesh"
            material="floorlamp_mat"/>

      <!-- MuJoCo will compute mass, COM, and inertia from mesh geometry and density=25 -->
      <!-- Expected values: mass=0.034 kg, com=-0.172881 0.058124 -0.034385, inertia=0.000252 0.001661 0.001789 -->
    </body>
  </worldbody>
</mujoco>
