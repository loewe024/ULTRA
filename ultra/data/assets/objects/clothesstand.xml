<mujoco model="clothesstand">
  <!-- Note: compiler and option settings are inherited from robot XML during merge -->

  <asset>
    <mesh name="clothesstand_mesh" file="objects/clothesstand/clothesstand.obj" scale="1.0 1.0 1.0"/>
    <material name="clothesstand_mat" rgba="0.7 0.8 0.9 1"/>
  </asset>

  <default>
    <default class="clothesstand_phys">
      <geom
        contype="1" conaffinity="1"
        friction="0.6 0.01 0.01"
        solimp="0.99 0.99 0.01"
        solref="0.01 1"
        density="25"
      />
    </default>
  </default>

  <worldbody>
    <body name="clothesstand" pos="0 0 0.9" quat="1 0 0 0">
      <freejoint name="clothesstand_free"/>

      <geom class="clothesstand_phys"
            name="clothesstand_geom"
            type="mesh" mesh="clothesstand_mesh"
            material="clothesstand_mat"/>

      <!-- MuJoCo will compute mass, COM, and inertia from mesh geometry and density=25 -->
      <!-- Expected values: mass=0.052 kg, com=-0.104045 0.136959 0.022799, inertia=0.000961 0.000626 0.001457 -->
    </body>
  </worldbody>
</mujoco>
