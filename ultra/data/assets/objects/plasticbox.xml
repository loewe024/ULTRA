<mujoco model="plasticbox">
  <!-- Note: compiler and option settings are inherited from robot XML during merge -->

  <asset>
    <mesh name="plasticbox_mesh" file="objects/plasticbox/plasticbox.obj" scale="1.0 1.0 1.0"/>
    <material name="plasticbox_mat" rgba="0.7 0.8 0.9 1"/>
  </asset>

  <default>
    <default class="plasticbox_phys">
      <geom
        contype="1" conaffinity="1"
        friction="0.6 0.01 0.01"
        solimp="0.99 0.99 0.01"
        solref="0.01 1"
        density="25"
      />
    </default>
  </default>

  <worldbody>
    <body name="plasticbox" pos="0 0 0.9" quat="1 0 0 0">
      <freejoint name="plasticbox_free"/>

      <geom class="plasticbox_phys"
            name="plasticbox_geom"
            type="mesh" mesh="plasticbox_mesh"
            material="plasticbox_mat"/>

      <!-- MuJoCo will compute mass, COM, and inertia from mesh geometry and density=25 -->
      <!-- Expected values: mass=0.002 kg, com=-0.018015 0.022049 -0.007698, inertia=0.000007 0.000012 0.000008 -->
    </body>
  </worldbody>
</mujoco>
