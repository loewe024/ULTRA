<mujoco model="smalltable">
  <!-- Note: compiler and option settings are inherited from robot XML during merge -->

  <asset>
    <mesh name="smalltable_mesh" file="objects/smalltable/smalltable.obj" scale="1.0 1.0 1.0"/>
    <material name="smalltable_mat" rgba="0.7 0.8 0.9 1"/>
  </asset>

  <default>
    <default class="smalltable_phys">
      <geom
        contype="1" conaffinity="1"
        friction="0.6 0.01 0.01"
        solimp="0.99 0.99 0.01"
        solref="0.01 1"
        density="25"
      />
    </default>
  </default>

  <worldbody>
    <body name="smalltable" pos="0 0 0.9" quat="1 0 0 0">
      <freejoint name="smalltable_free"/>

      <geom class="smalltable_phys"
            name="smalltable_geom"
            type="mesh" mesh="smalltable_mesh"
            material="smalltable_mat"/>

      <!-- MuJoCo will compute mass, COM, and inertia from mesh geometry and density=25 -->
      <!-- Expected values: mass=0.054 kg, com=0.000578 0.025512 0.000071, inertia=0.000118 0.000152 0.000118 -->
    </body>
  </worldbody>
</mujoco>
