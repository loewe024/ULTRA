<mujoco model="vacuum">
  <!-- Note: compiler and option settings are inherited from robot XML during merge -->

  <asset>
    <mesh name="vacuum_mesh" file="objects/vacuum/vacuum.obj" scale="1.0 1.0 1.0"/>
    <material name="vacuum_mat" rgba="0.7 0.8 0.9 1"/>
  </asset>

  <default>
    <default class="vacuum_phys">
      <geom
        contype="1" conaffinity="1"
        friction="0.6 0.01 0.01"
        solimp="0.99 0.99 0.01"
        solref="0.01 1"
        density="25"
      />
    </default>
  </default>

  <worldbody>
    <body name="vacuum" pos="0 0 0.9" quat="1 0 0 0">
      <freejoint name="vacuum_free"/>

      <geom class="vacuum_phys"
            name="vacuum_geom"
            type="mesh" mesh="vacuum_mesh"
            material="vacuum_mat"/>

      <!-- MuJoCo will compute mass, COM, and inertia from mesh geometry and density=25 -->
      <!-- Expected values: mass=0.043 kg, com=-0.167274 0.065037 -0.096713, inertia=0.000127 0.000333 0.000292 -->
    </body>
  </worldbody>
</mujoco>
