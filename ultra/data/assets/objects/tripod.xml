<mujoco model="tripod">
  <!-- Note: compiler and option settings are inherited from robot XML during merge -->

  <asset>
    <mesh name="tripod_mesh" file="objects/tripod/tripod.obj" scale="1.0 1.0 1.0"/>
    <material name="tripod_mat" rgba="0.7 0.8 0.9 1"/>
  </asset>

  <default>
    <default class="tripod_phys">
      <geom
        contype="1" conaffinity="1"
        friction="0.6 0.01 0.01"
        solimp="0.99 0.99 0.01"
        solref="0.01 1"
        density="25"
      />
    </default>
  </default>

  <worldbody>
    <body name="tripod" pos="0 0 0.9" quat="1 0 0 0">
      <freejoint name="tripod_free"/>

      <geom class="tripod_phys"
            name="tripod_geom"
            type="mesh" mesh="tripod_mesh"
            material="tripod_mat"/>

      <!-- MuJoCo will compute mass, COM, and inertia from mesh geometry and density=25 -->
      <!-- Expected values: mass=0.006 kg, com=0.078714 -0.070587 -0.004883, inertia=0.000059 0.000077 0.000134 -->
    </body>
  </worldbody>
</mujoco>
